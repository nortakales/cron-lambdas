<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nortakales.chat-db-poke</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCRIPT_DIR__/chat-db-poke.sh</string>
    </array>

    <!-- 30s: the worst-case delay a message can sit in the WAL unseen. Cheap,
         because the script exits without touching anything unless the WAL is
         actually ahead of chat.db. Not KeepAlive -- this is a periodic poke
         that must exit, not a daemon. -->
    <key>StartInterval</key>
    <integer>30</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Only writes a line when it actually pokes, so this stays small. -->
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/chat-db-poke.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/chat-db-poke.log</string>

    <!-- Reading ~/Library/Messages needs Full Disk Access, which is granted per
         binary. A LaunchAgent in the GUI session inherits the user's grants. -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
