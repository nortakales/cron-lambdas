<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.nortakales.icloud-bridge.reminders-helper</string>
    <key>CFBundleName</key>
    <string>iCloud Bridge Reminders Helper</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <!-- macOS 14+ split Reminders access into full and write-only. Both strings
         are present so the prompt reads correctly whichever API path is taken. -->
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>The iCloud bridge mirrors your reminders to your own AWS account and creates reminders you request through its API.</string>
    <key>NSRemindersUsageDescription</key>
    <string>The iCloud bridge mirrors your reminders to your own AWS account and creates reminders you request through its API.</string>
</dict>
</plist>
